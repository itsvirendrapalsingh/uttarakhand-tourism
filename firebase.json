{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**", "android_app/**", "content/**", "tools/**", "build.js",
      "*.sh", "*.py", "*.md", "CNAME", "www.uttarakhandtourismcenter.com",
      "images_backup*/**", "images/destinations/**", "images/gallery/**", "images/heroes/**", "images/*.jpg"
    ],
    "redirects": [
      { "source": "/", "destination": "/home.html", "type": 302 },
      { "source": "/index.html", "destination": "/home.html", "type": 301 },
      { "regex": "^/(.+)/index\\.html$", "destination": "/:1/", "type": 301 }
    ],
    "headers": [
      { "source": "images/opt/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  }
}
